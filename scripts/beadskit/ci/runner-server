#!/bin/sh
# Eigene GitHub-Actions-Runner für die CI, als Docker-Container auf dem Server. Die Jobs laufen
# im Container, ohne Docker-Socket und ohne Host-Verzeichnisse, mit CPU- und Speichergrenze,
# damit PR-Code die Produktion auf demselben Server nicht stört. ci.yml wählt sie per Label
# (Standard: BK_SLUG aus beads.project.sh), z. B. `runs-on: [self-hosted, regiehub]`.
# Teil des beadskit aus dem ProjectTemplate – nicht im Projekt ändern.
# Abgelöst durch den gemeinsamen Pool (ci/runner-pool). Hier nur noch zum Abbauen alter Runner
# (`remove`) und für Projekte, die den Pool noch nicht nutzen.
#
#   runner-server setup [--dry-run] [--recreate]  Image bauen, Runner registrieren (kurzlebiges Token), alle starten
#   runner-server status [--json]     Container auf dem Server und Status bei GitHub
#   runner-server start <n…|mysql|all>  Runner (oder die CI-MySQL) einschalten, nimmt wieder Jobs an
#   runner-server stop <n…|mysql|all> [--force]  Runner (oder die CI-MySQL) ausschalten
#   runner-server add                 einen Runner mehr (kleinste freie Nummer, höchstens 8)
#   runner-server delete [n] [--force]  Runner n löschen (ohne n: den mit der höchsten Nummer)
#   runner-server logs                letzte Zeilen der Runner-Logs
#   runner-server remove              Runner bei GitHub abmelden, Container und Volumes löschen
#
# Ein gestoppter Runner ist bei GitHub offline und bekommt keine Jobs; die Registrierung bleibt im
# Volume, und wegen `restart: unless-stopped` bleibt er auch nach einem Server-Neustart aus.
# `stop` verweigert ohne --force, wenn der Runner gerade einen Job hat (der Job bräche ab) oder
# danach keiner mehr liefe (die CI bliebe in „Queued“). `setup` startet wieder alle, ersetzt aber
# keine laufenden Container (sonst brächen deren Jobs ab, auch wenn nur das Image neu gebaut ist).
# Neues Image oder geänderte Grenzen übernehmen: `setup --recreate`, wenn kein Job läuft.
# CPU-Vorrang: Runner und MySQL laufen mit niedrigem `cpu_shares` (RUNNER_CPU_SHARES, Docker-Standard
# 1024), nehmen also nur CPU, die Dienste auf dem Host gerade nicht brauchen. `cpus` begrenzt jeden
# Runner nach oben. Gesamtdeckel: alle Container liegen in der systemd-Slice beadskit-ci.slice
# (CPUQuota = RUNNER_CI_CPUS Kerne, MemoryMax = RUNNER_CI_MEM, niedriges CPU- und IO-Gewicht), die
# alle beadskit-Projekte auf dem Server teilen; `setup` schreibt sie und setzt die Werte sofort.
# Mehr Runner machen die CI dann nur paralleler, nicht den Host langsamer.
# Die Runner stehen als Dienste runner-<n> in compose.yml auf dem Server. `add` nimmt die kleinste
# freie Nummer, `delete n` löscht genau Runner n (Lücken sind erlaubt) und verweigert wie `stop`
# bei laufendem Job oder wenn danach keiner mehr liefe.
# `status --json` nennt je Runner auch den laufenden Job, CPU (% eines Kerns) und RAM (Bytes), zählt
# die wartenden Jobs und misst die Slice (cpuPct, Quota in Kernen, RAM).
# Mit RUNNER_MYSQL (z. B. 8.0) läuft neben den Runnern der Dienst `mysql` (nur im Netz ci, Daten im
# RAM, root-Passwort ci) für DB-Tests; `setup` und `start all` starten ihn mit, `stop all` hält ihn
# mit an. Einzeln: `start mysql` / `stop mysql` (verweigert, solange ein Runner einen Job hat, weil
# dessen DB-Tests abbrächen). `add`/`delete` lassen ihn in Ruhe. `status --json` meldet ihn unter
# mysql (container, cpu, mem; null ohne RUNNER_MYSQL und ohne Container). Gesteuert auch aus dem
# Leitstand (Abschnitt CI-Runner).
#
# Einstellungen per Umgebung (Standard in Klammern): RUNNER_SSH_HOST (server),
# RUNNER_REPO (GitHub-Repo dieses Checkouts), RUNNER_LABEL (BK_SLUG), RUNNER_COUNT (Anzahl aus
# compose.yml auf dem Server, ohne compose.yml 3), RUNNER_CPUS (2), RUNNER_CPU_SHARES (128), RUNNER_MEM (6g),
# RUNNER_CI_CPUS (4, Kerne für alle CI-Container zusammen), RUNNER_CI_MEM (24G),
# RUNNER_APT (zusätzliche apt-Pakete im Image), RUNNER_MYSQL (MySQL-Version, leer = kein MySQL).
# beads.project.sh kann sie setzen. Ablage auf dem Server: /opt/<label>-runner (Dockerfile, compose.yml). Das Token zum Registrieren
# gilt eine Stunde und wird nicht gespeichert; die Runner-Zugangsdaten liegen in den Volumes.
set -eu

# shellcheck source=lib.sh
. "$(dirname "$0")/lib.sh"
ROOT=$(git -C "$(dirname "$0")" rev-parse --path-format=absolute --git-common-dir)
ROOT=$(dirname "$ROOT")
BK_SLUG=""
# BK_PROJECT_FILE: andere Projektdatei (Tests: /dev/null, damit die Einstellungen des Projekts nicht greifen)
PROJECT_FILE=${BK_PROJECT_FILE:-$ROOT/beads.project.sh}
# shellcheck source=/dev/null
[ ! -f "$PROJECT_FILE" ] || . "$PROJECT_FILE"
SSH_HOST=${RUNNER_SSH_HOST:-server}
REPO=${RUNNER_REPO:-$(cd "$ROOT" && gh repo view --json nameWithOwner --jq .nameWithOwner 2>/dev/null || true)}
LABEL=${RUNNER_LABEL:-$BK_SLUG}
# shellcheck disable=SC2034  # in lib.sh verwendet
EXTRA_APT=${RUNNER_APT:-}
MYSQL_VERSION=${RUNNER_MYSQL:-}
[ -n "$REPO" ] || { echo "GitHub-Repo unbekannt: RUNNER_REPO=owner/name setzen" >&2; exit 1; }
case $LABEL in ''|*[!a-z0-9-]*) echo "Runner-Label ungültig: '$LABEL' (RUNNER_LABEL oder BK_SLUG)" >&2; exit 1 ;; esac
case $MYSQL_VERSION in *[!0-9.]*) echo "RUNNER_MYSQL ungültig: '$MYSQL_VERSION'" >&2; exit 1 ;; esac
COUNT=${RUNNER_COUNT:-}
MAX=8
CPUS=${RUNNER_CPUS:-2}
CPU_SHARES=${RUNNER_CPU_SHARES:-128}
case $CPU_SHARES in '' | 0* | 1 | *[!0-9]*) echo "RUNNER_CPU_SHARES ungültig: '$CPU_SHARES' (ganze Zahl ab 2)" >&2; exit 1 ;; esac
MEM=${RUNNER_MEM:-6g}
CI_CPUS=${RUNNER_CI_CPUS:-4}
case $CI_CPUS in '' | 0* | *[!0-9]*) echo "RUNNER_CI_CPUS ungültig: '$CI_CPUS' (ganze Zahl ab 1)" >&2; exit 1 ;; esac
CI_MEM=${RUNNER_CI_MEM:-24G}
printf '%s' "$CI_MEM" | grep -Eq '^[1-9][0-9]*[KMGT]?$' || { echo "RUNNER_CI_MEM ungültig: '$CI_MEM' (z. B. 24G)" >&2; exit 1; }
SLICE=beadskit-ci.slice
export SLICE
VERSION=$RUNNER_VERSION
DIR=/opt/$LABEL-runner

usage() {
  sed -n '10,17s/^# \{0,1\}//p' "$0" >&2
  exit 2
}

remote() {
  ssh -o BatchMode=yes "$SSH_HOST" "$@"
}

# Nummern 1 … $1, eine je Zeile
seq_to() {
  i=1
  while [ "$i" -le "$1" ]; do
    echo "$i"
    i=$((i + 1))
  done
}

# NUMS (Nummern der Runner, durch Leerzeichen getrennt) und COUNT: aus RUNNER_COUNT (1 … n),
# sonst aus den Diensten in compose.yml auf dem Server, sonst 1 … 3
load_count() {
  if [ -n "$COUNT" ]; then
    NUMS=$(seq_to "$COUNT" | tr '\n' ' ')
    return 0
  fi
  # ohne Server keine Schätzung: add/delete schrieben sonst compose.yml mit falschen Runnern
  NUMS=$(remote "sed -n 's/^  runner-\([0-9]*\):\$/\1/p' $DIR/compose.yml 2>/dev/null || true") || {
    echo "$SSH_HOST nicht erreichbar" >&2
    exit 1
  }
  # shellcheck disable=SC2086
  NUMS=$(printf '%s\n' $NUMS | grep -E '^[1-9][0-9]*$' | sort -n -u | tr '\n' ' ' || true)
  [ -n "$NUMS" ] || NUMS=$(seq_to 3 | tr '\n' ' ')
  set_count
}

set_count() {
  # shellcheck disable=SC2086
  COUNT=$(printf '%s\n' $NUMS | grep -c . || true)
}

runners() {
  # shellcheck disable=SC2086
  printf '%s\n' $NUMS
}

has_runner() {
  case " $NUMS " in *" $1 "*) return 0 ;; esac
  return 1
}

# Kleinste freie Nummer 1 … MAX
free_number() {
  for i in $(seq_to "$MAX"); do
    has_runner "$i" || { echo "$i"; return; }
  done
}

compose_file() {
  cat <<EOF
# Erzeugt von beadskit ci/runner-server – nicht von Hand ändern.
name: $LABEL-runner
x-runner: &runner
  build: .
  image: $LABEL-runner:$VERSION
  command: ./run.sh
  restart: unless-stopped
  cgroup_parent: $SLICE
  cpus: $CPUS
  cpu_shares: $CPU_SHARES
  mem_limit: $MEM
  pids_limit: 4096
  security_opt: ["no-new-privileges:true"]
  networks: [ci]
services:
EOF
  [ -z "$MYSQL_VERSION" ] || cat <<EOF
  # MySQL für DB-Tests (RUNNER_MYSQL), nur im Netz ci, kein Port nach außen; Daten im RAM
  mysql:
    image: mysql:$MYSQL_VERSION
    restart: unless-stopped
    environment:
      MYSQL_ROOT_PASSWORD: ci
    command: ["--innodb-buffer-pool-size=256M", "--max-connections=200"]
    tmpfs: ["/var/lib/mysql"]
    cgroup_parent: $SLICE
    cpus: 1
    cpu_shares: $CPU_SHARES
    mem_limit: 1g
    security_opt: ["no-new-privileges:true"]
    networks: [ci]
EOF
  for i in $(runners); do
    printf '  runner-%s:\n    <<: *runner\n    volumes: ["runner-%s:/home/runner"]\n' "$i" "$i"
  done
  printf 'networks:\n  ci: {}\nvolumes:\n'
  for i in $(runners); do
    printf '  runner-%s: {}\n' "$i"
  done
}

# Skript für den Server; $1 = Registrierungs-Token, $2 = Argumente für `docker compose up -d`,
# $3 = Nummern der Runner, die registriert sein müssen
setup_script() {
  cat <<EOF
set -euo pipefail
T='$1'
$(slice_script)
mkdir -p $DIR && cd $DIR
cat >Dockerfile <<'DOCKERFILE'
$(dockerfile)
DOCKERFILE
cat >compose.yml <<'COMPOSE'
$(compose_file)
COMPOSE
docker compose build -q
EOF
  for i in $3; do
    cat <<EOF
if docker compose run --rm --no-deps -T runner-$i test -f .runner </dev/null; then
  echo "runner-$i: schon registriert"
else
  docker compose run --rm --no-deps -T -e T="\$T" runner-$i bash -c \\
    './config.sh --unattended --url https://github.com/$REPO --token "\$T" --name $LABEL-runner-$i --labels $LABEL --work _work --replace' </dev/null
fi
EOF
  done
  echo "docker compose up -d $2"
  echo "docker compose ps"
}

remove_script() {
  cat <<EOF
set -euo pipefail
T='$1'
cd $DIR
EOF
  for i in $(runners); do
    echo "docker compose run --rm --no-deps -T -e T=\"\$T\" runner-$i bash -c './config.sh remove --token \"\$T\"' </dev/null || true"
  done
  echo "docker compose down -v --rmi local"
  echo "cd / && rm -rf $DIR"
}

token() {
  gh api -X POST "repos/$REPO/actions/runners/$1" --jq .token
}

cmd_setup() {
  dry=
  up=--no-recreate
  for a in "$@"; do
    case $a in
      --dry-run) dry=1 ;;
      --recreate) up= ;;
      *) usage ;;
    esac
  done
  if [ -n "$dry" ]; then
    echo "# ssh $SSH_HOST bash -s"
    setup_script '<token>' "$up" "$(runners)"
    return
  fi
  setup_script "$(token registration-token)" "$up" "$(runners)" | remote bash -s
  cmd_status
}

cmd_status() {
  remote "cd $DIR 2>/dev/null && docker compose ps --format 'table {{.Service}}\t{{.Status}}' || echo 'keine Runner auf $SSH_HOST'"
  echo
  gh api "repos/$REPO/actions/runners" --jq '.runners[] | "\(.name)\t\(.status)\t\(if .busy then "busy" else "idle" end)\t\([.labels[].name] | join(","))"'
  echo
  usage_script | remote bash -s 2>/dev/null | jq -r '.slice | "CI gesamt (\($ENV.SLICE)): \(.cpuPct // "?") % CPU von \(if .cpus then "\(.cpus * 100) %" else "unbegrenzt" end), RAM \(if .mem then "\(.mem / 1073741824 * 10 | floor / 10) GiB" else "?" end)"' || true
}

# Zustand je Runner als JSON-Liste: n, name, container (running, exited, … oder missing),
# github (online, offline oder missing), busy
# Zustand der Container als JSON-Objekt Dienst → State (running, exited, …)
container_states() {
  remote "cd $DIR 2>/dev/null && docker compose ps --all --format json || true" |
    jq -s 'map({key: .Service, value: .State}) | from_entries'
}

# $1 = Ergebnis von container_states (optional, sonst neu gelesen)
runner_state() {
  containers=${1:-$(container_states)}
  github=$(gh api "repos/$REPO/actions/runners" --jq '[.runners[] | {key: .name, value: {status, busy}}] | from_entries')
  nums=$(runners | jq -s -c .)
  jq -n --argjson c "$containers" --argjson g "$github" --argjson nums "$nums" --arg label "$LABEL" '
    [$nums[] as $n | "\($label)-runner-\($n)" as $name | {
      n: $n, name: $name,
      container: ($c["runner-\($n)"] // "missing"),
      github: ($g[$name].status // "missing"),
      busy: ($g[$name].busy // false)
    }]'
}

# Nicht abgeschlossene Jobs der offenen Workflow-Läufe, ein JSON-Objekt je Zeile
active_jobs() {
  tab=$(printf '\t')
  gh api "repos/$REPO/actions/runs?per_page=30" \
    --jq '.workflow_runs[] | select(.status != "completed") | "\(.id)\t\(.head_branch)\t\(.display_title)"' |
    {
      # je Lauf parallel; jede Ausgabezeile ist kurz und wird am Stück geschrieben
      while IFS=$tab read -r id branch title; do
        gh api "repos/$REPO/actions/runs/$id/jobs?per_page=100" |
          jq -c --arg branch "$branch" --arg title "$title" '.jobs[] | select(.status != "completed") |
            {runner: .runner_name, status, name, url: .html_url, started: .started_at, branch: $branch, title: $title}' &
      done
      wait
    }
}

# {runners: [… mit job (laufender Job oder null), cpu, mem], queued: Anzahl wartender Jobs, slice}
cmd_status_json() {
  # Messung (dauert so lange wie docker stats) parallel zu den GitHub-Abfragen
  tmp=$(mktemp)
  usage_script | remote bash -s >"$tmp" 2>/dev/null &
  upid=$!
  containers=$(container_states)
  state=$(runner_state "$containers")
  jobs=$(active_jobs | jq -s .)
  wait "$upid" || true
  usage=$(jq -c . "$tmp" 2>/dev/null || true)
  rm -f "$tmp"
  jq -n --argjson r "$state" --argjson j "$jobs" --argjson u "${usage:-"{}"}" --argjson c "$containers" \
    --arg mysql "$MYSQL_VERSION" '{
    runners: [$r[] | .name as $name | . + {job: ([$j[] | select(.status == "in_progress" and .runner == $name)
      | {name, branch, title, url, started}][0] // null),
      cpu: ($u.containers["runner-\(.n)"].cpu // null), mem: ($u.containers["runner-\(.n)"].mem // null)}],
    queued: ([$j[] | select(.status != "in_progress")] | length),
    mysql: (if $mysql != "" or $c.mysql then {container: ($c.mysql // "missing"),
      cpu: ($u.containers.mysql.cpu // null), mem: ($u.containers.mysql.mem // null)} else null end),
    slice: ($u.slice // null)
  }'
}

# Runner-Nummern aus den Argumenten, eine je Zeile: vorhandene Nummern oder all
pick() {
  [ $# -ge 1 ] || usage
  if [ "$1" = all ] && [ $# -eq 1 ]; then
    runners
    return
  fi
  for n in "$@"; do
    case $n in '' | 0* | *[!0-9]*) usage ;; esac
    has_runner "$n" || { echo "Runner $n gibt es nicht (vorhanden: $NUMS)" >&2; exit 2; }
    echo "$n"
  done
}

services() {
  for n in "$@"; do printf ' runner-%s' "$n"; done
}

cmd_start() {
  if [ "$*" = mysql ]; then
    remote "cd $DIR && docker compose up -d --no-recreate mysql"
    return
  fi
  ns=$(pick "$@") || exit 2
  # shellcheck disable=SC2086
  remote "cd $DIR && docker compose up -d --no-recreate$(services $ns)$(all_mysql "$@")"
}

# " mysql" bei `all`, wenn das Projekt eine CI-MySQL hat
all_mysql() {
  [ "$*" = all ] && [ -n "$MYSQL_VERSION" ] && printf ' mysql' || true
}

cmd_stop() {
  force=
  set -- "$@" --
  while [ "$1" != -- ]; do
    if [ "$1" = --force ]; then force=1; else set -- "$@" "$1"; fi
    shift
  done
  shift
  if [ "$*" = mysql ]; then
    [ -n "$force" ] || guard_mysql
    remote "cd $DIR && docker compose stop mysql"
    return
  fi
  ns=$(pick "$@") || exit 2
  # shellcheck disable=SC2086
  [ -n "$force" ] || guard_stop $ns
  # shellcheck disable=SC2086
  remote "cd $DIR && docker compose stop$(services $ns)$(all_mysql "$@")"
}

# Bricht ab, wenn ein Runner einen Job hat (dessen DB-Tests brauchen die MySQL)
guard_mysql() {
  busy=$(runner_state | jq -r '[.[] | select(.busy) | .name] | join(", ")')
  if [ -n "$busy" ]; then
    echo "$busy arbeitet gerade an einem Job, dessen DB-Tests ohne MySQL abbrächen. Trotzdem: --force" >&2
    exit 1
  fi
}

# Bricht ab, wenn einer der Runner einen Job hat oder danach keiner mehr liefe
guard_stop() {
  st=$(runner_state)
  list=$(printf '%s\n' "$@" | jq -s -c .)
  busy=$(echo "$st" | jq -r --argjson ns "$list" '[.[] | select(.busy and (.n | IN($ns[]))) | .name] | join(", ")')
  if [ -n "$busy" ]; then
    echo "$busy arbeitet gerade an einem Job, der beim Stoppen abbräche. Trotzdem: --force" >&2
    exit 1
  fi
  left=$(echo "$st" | jq --argjson ns "$list" '[.[] | select(.container == "running" and (.n | IN($ns[]) | not))] | length')
  if [ "$left" -eq 0 ]; then
    echo "Danach liefe kein Runner mehr, CI-Jobs blieben in der Warteschlange. Trotzdem: --force" >&2
    exit 1
  fi
}

cmd_add() {
  if [ "$COUNT" -ge "$MAX" ]; then
    echo "Schon $COUNT Runner, mehr als $MAX gehen nicht." >&2
    exit 1
  fi
  n=$(free_number)
  # shellcheck disable=SC2086
  NUMS=$(printf '%s\n' $NUMS "$n" | sort -n | tr '\n' ' ')
  set_count
  warn_cores
  setup_script "$(token registration-token)" "--no-recreate runner-$n" "$n" | remote bash -s
  echo "$LABEL-runner-$n hinzugefügt."
}

# Hinweis, wenn die Runner zusammen mehr Kerne wollen, als die Slice hergibt
warn_cores() {
  # RUNNER_CPUS darf eine Kommazahl sein (1.5): auf ganze Kerne aufrunden
  need=$(awk -v n="$COUNT" -v c="$CPUS" 'BEGIN { x = n * c; printf "%d", (x == int(x)) ? x : int(x) + 1 }')
  if [ "$need" -gt "$CI_CPUS" ]; then
    echo "Hinweis: $COUNT Runner × $CPUS CPUs = $need, die CI darf zusammen $CI_CPUS Kerne nutzen" >&2
    echo "(RUNNER_CI_CPUS). Gleichzeitige Jobs teilen sie sich und werden langsamer, der Host nicht." >&2
  fi
}

# Löscht Runner n (ohne n den mit der höchsten Nummer): Container stoppen und löschen, Volume
# löschen, compose.yml ohne ihn, bei GitHub abmelden
cmd_delete() {
  force=''
  n=''
  for a in "$@"; do
    case $a in
      --force) force=1 ;;
      '' | 0* | *[!0-9]*) usage ;;
      *) [ -z "$n" ] || usage; n=$a ;;
    esac
  done
  [ -n "$n" ] || n=$(runners | tail -n 1)
  has_runner "$n" || { echo "Runner $n gibt es nicht (vorhanden: $NUMS)" >&2; exit 2; }
  if [ "$COUNT" -le 1 ]; then
    echo "Der letzte Runner bleibt. Alle entfernen: runner-server remove" >&2
    exit 1
  fi
  [ -n "$force" ] || guard_stop "$n"
  id=$(gh api "repos/$REPO/actions/runners" --jq ".runners[] | select(.name == \"$LABEL-runner-$n\") | .id")
  NUMS=$(runners | grep -v -x "$n" | tr '\n' ' ')
  set_count
  remote bash -s <<EOF
set -euo pipefail
cd $DIR
docker compose stop runner-$n
docker compose rm -f runner-$n
docker volume rm -f $LABEL-runner_runner-$n
cat >compose.yml <<'COMPOSE'
$(compose_file)
COMPOSE
EOF
  [ -z "$id" ] || gh api -X DELETE "repos/$REPO/actions/runners/$id"
  echo "$LABEL-runner-$n gelöscht."
}

cmd_logs() {
  remote "cd $DIR && docker compose logs --tail 40"
}

cmd_remove() {
  remove_script "$(token remove-token)" | remote bash -s
  echo "Runner entfernt."
}

[ $# -ge 1 ] || usage
cmd=$1
shift
case $cmd in
  setup | status | start | stop | add | delete | logs | remove) load_count ;;
  *) usage ;;
esac
case $cmd in
  setup) cmd_setup "$@" ;;
  status)
    case ${1-} in
      '') cmd_status ;;
      --json) cmd_status_json ;;
      *) usage ;;
    esac
    ;;
  start) cmd_start "$@" ;;
  stop) cmd_stop "$@" ;;
  add) [ $# -eq 0 ] || usage; cmd_add ;;
  delete) cmd_delete "$@" ;;
  logs) cmd_logs ;;
  remove) cmd_remove ;;
  *) usage ;;
esac
