#!/bin/sh
# Startet und verwaltet die Worker der beads-Pipeline (Regeln: .claude/skills/worker-regeln.md).
# Jeder Worker heißt wie sein Worktree (<rolle>-<n>, z. B. fix-2, club-add-1); das ist zugleich
# der beads-Actor (bdw). Rollen gehören zu einem Workspace: code (BK_ROLES) und die weiteren
# aus BK_WORKSPACES in beads.project.sh.
#
#   workers start [--ws <ws>] [<rolle>=N …] [--term iterm|tmux|bg] [--dry-run]   Workspace starten
#   workers add <rolle>[=N] … [--ws <ws>] [--term …] [--dry-run]   N weitere Worker (Standard 1)
#   workers ls [--ws <ws>]      Worker dieses Repos mit Rolle und Status
#   workers attach <name>       Worker in diesem Terminal öffnen (Hintergrund oder tmux-Fenster)
#   workers logs <name>         letzte Ausgabe eines Hintergrund-Workers
#   workers drain [rolle…] [--ws <ws>] [--host <h>] [--off]   Worker (alle, Rollen, Workspace, Rechner) auslaufen lassen
#   workers drain-check [rolle]   DRAIN, wenn dieser Worker auslaufen soll (Rolle sonst aus dem Worktree)
#   workers stop <name>|--all [--force]   Worker sofort stoppen (Hintergrund und Terminal)
#   workers restart <name> [--force] [--term …] [--dry-run]   Worker mit frischem Kontext neu starten
#   workers autorestart [--over 200k] [--off]   Leitstand startet große Kontexte selbst neu
#   workers send <name> [--] <text>   Nachricht oder /befehl in das Terminal eines Workers tippen
#   workers repo-for <issue-id>   Repo-Pfad, in dem das Issue bearbeitet wird (BK_REPOS)
#   workers config              Projekt-Konfiguration als JSON (für den Leitstand)
#   workers top [slug…] [--once]   Live-Übersicht aller Projekte und Worker im Terminal (q beendet)
#
# Teil des beadskit aus dem ProjectTemplate – nicht im Projekt ändern. Was projektspezifisch
# ist (Name, Ziel-Branch, Rollen, Workspaces, Skills, Module, Repos), steht in beads.project.sh
# im Repo-Wurzelordner.
#
# `start` startet genau einen Workspace: ohne --ws den aus den angegebenen Rollen, sonst code
# (Standard BK_START bzw. BK_WS_<ws>_START). Rollen eines anderen Workspaces lehnt es ab. N ist
# die Gesamtzahl je Rolle (fix-1..fix-N, laufende werden übersprungen). `add` startet N
# zusätzliche Worker mit den nächsten freien Nummern und hängt die Tabs ins vorderste
# iTerm-Fenster statt ein neues zu öffnen.
#
# Worker laufen in einem Terminal, eines je Worker, Farbe je Rolle (dort lassen sie sich aus dem
# Leitstand per `send` ansprechen): auf macOS als iTerm-Tab, unter Linux als Fenster der
# tmux-Session bk-<slug>. Mit --bg (--term bg) als Hintergrund-Sessions (claude --bg); BK_TERM
# setzt die Vorgabe. Lässt sich das Terminal nicht steuern (kein iTerm, keine Automation-Freigabe,
# kein tmux), starten die Worker im Hintergrund. `restart` startet auch Hintergrund-Worker in
# einem Terminal neu. --dry-run zeigt nur, was gestartet bzw. an Markierungen geändert würde.
#
# Zwei Rechner (ProjectTemplate/scripts/remote): Steht in ~/.config/beadskit/hosts.conf ein
# LEADER, teilen sich die Rechner die beads-Datenbank auf dem Leitrechner. Worker heißen dann
# <rolle>-<BK_HOST_BASE + n> (Mac fix-1, PC fix-101), die Markierungen (Drain, Auto-Neustart)
# liegen in `bd kv` statt im Git-Verzeichnis, und `drain --host <h>` lässt nur einen Rechner
# auslaufen. HOST_<h>_ROLES begrenzt, welche Rollen `start` dort ohne Angabe startet.
#
# Sauber beenden: erst `drain` (Worker claimen nichts Neues und hören nach dem laufenden
# Issue auf, siehe worker-regeln.md „Auslaufen“), warten bis `ls` alle als idle zeigt,
# dann `stop --all`. `stop` allein bricht mitten in der Arbeit ab. `drain fix` lässt nur
# die Fix-Worker auslaufen, `drain --ws <ws>` alle Rollen eines Workspaces (je Rolle eine
# Markierung), `drain fix --off` bzw. `drain --ws <ws> --off` hebt das wieder auf, `drain --off` alles.
# `start` hebt den Drain nur für den gestarteten Workspace auf: dessen Rollenmarkierungen fallen
# weg; ein globaler Drain wird dabei in Rollenmarkierungen der übrigen Workspaces umgewandelt,
# damit deren Worker weiter auslaufen.
#
# Kontext: ein Worker unter /loop sammelt alle Runden in einer Session. `restart` startet ihn
# zwischen zwei Runden neu (idle, ohne Claim, ohne Merge-Slot), auch im Terminal (dort SIGTERM
# an die Session und der Startbefehl in die Shell desselben Tabs bzw. tmux-Fensters). `autorestart`
# legt eine Markierung mit der Schwelle an; der Leitstand prüft jede Minute und ruft `restart` auf.
# Ohne laufenden Leitstand passiert nichts automatisch.
set -eu

ROOT=$(git -C "$(dirname "$0")" rev-parse --path-format=absolute --git-common-dir)
ROOT=$(dirname "$ROOT")
WT_DIR="$ROOT/.claude/worktrees"
KIT="$ROOT/scripts/beadskit"

# ---- Projekt-Konfiguration (beads.project.sh) mit Vorgaben ----
BK_NAME=$(basename "$ROOT")
BK_SLUG=""
BK_BASE=main
BK_ROLES="fix search verify regress"
BK_PHASES="fix verify merge"
BK_SKILL_PREFIX=""
BK_MODULES=""
BK_START="fix=2 search=1 verify=1 regress=0"
BK_WORKSPACES=""
BK_REPOS=""
if [ ! -f "$ROOT/beads.project.sh" ]; then
  echo "beads.project.sh fehlt in $ROOT (Einrichtung: ProjectTemplate/beadskit-sync.sh --adopt)" >&2
  exit 1
fi
# shellcheck source=/dev/null
. "$ROOT/beads.project.sh"
[ -n "$BK_SLUG" ] || BK_SLUG=$(printf '%s' "$BK_NAME" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-')
[ -n "$BK_SKILL_PREFIX" ] || BK_SKILL_PREFIX=$BK_SLUG
WORKSPACES="code $BK_WORKSPACES"

# Wert der Variablen BK_WS_<ws>_<feld> (Workspace-Namen sind geprüft a-z, eval ist damit sicher)
ws_var() { eval "printf '%s' \"\${BK_WS_$1_$2-}\""; }

# Startbefehl je Rolle. beads.project.sh kann bk_prompt <rolle> selbst definieren.
default_prompt() {
  if command -v bk_prompt >/dev/null 2>&1; then
    p=$(bk_prompt "$1")
    if [ -n "$p" ]; then echo "$p"; return; fi
  fi
  case $1 in
    # /loop: leere Warteschlange beendet nur die Runde, Rückläufer werden später aufgenommen
    fix) echo "/loop 10m /$BK_SKILL_PREFIX-fix" ;;
    verify) echo "/loop 5m /$BK_SKILL_PREFIX-verify" ;;
    regress) echo "/loop 30m /$BK_SKILL_PREFIX-regress" ;;
    *) echo "/$BK_SKILL_PREFIX-$1" ;;
  esac
}

# iTerm-Tabfarbe als "r g b". beads.project.sh kann bk_color <rolle> selbst definieren.
default_color() {
  if command -v bk_color >/dev/null 2>&1; then
    c=$(bk_color "$1")
    if [ -n "$c" ]; then echo "$c"; return; fi
  fi
  case $1 in
    fix) echo "200 60 60" ;;
    search) echo "60 110 210" ;;
    verify) echo "50 160 80" ;;
    regress) echo "210 170 40" ;;
    *) echo "120 120 120" ;;
  esac
}

# Anzahl einer Rolle aus einer Vorgabe wie "fix=2 search=1"; 0, wenn sie fehlt
start_count() {
  for kv in $2; do [ "${kv%%=*}" != "$1" ] || { echo "${kv#*=}"; return; }; done
  echo 0
}

# Rollentabelle: rolle|workspace|prompt|iTerm-Tabfarbe "r g b"|Anzahl bei start ohne Angabe.
# Rollennamen nur a-z und "-" (die Zähler-Variable ersetzt "-" durch "_"), Workspaces nur a-z.
ROLE_TABLE=""
for w in $WORKSPACES; do
  # [:lower:] statt a-z: in manchen Locales liegt „C“ zwischen a und z
  case $w in ''|*[![:lower:]]*) echo "Workspace-Name nur a-z: $w (BK_WORKSPACES in beads.project.sh)" >&2; exit 1 ;; esac
  if [ "$w" = code ]; then roles=$BK_ROLES start=$BK_START; else roles=$(ws_var "$w" ROLES) start=$(ws_var "$w" START); fi
  [ -n "$roles" ] || { echo "Workspace $w ohne Rollen (BK_WS_${w}_ROLES in beads.project.sh)" >&2; exit 1; }
  for r in $roles; do
    case $r in *[![:lower:]-]*|[![:lower:]]*|*-|*--*) echo "Rollenname nur a-z und -: $r (beads.project.sh)" >&2; exit 1 ;; esac
    case "
$ROLE_TABLE" in *"
$r|"*) echo "Rolle $r doppelt (beads.project.sh)" >&2; exit 1 ;; esac
    ROLE_TABLE="$ROLE_TABLE${ROLE_TABLE:+
}$r|$w|$(default_prompt "$r")|$(default_color "$r")|$(start_count "$r" "$start")"
  done
done

CONF=${BEADSKIT_HOME:-$HOME/.config/beadskit}

# Der Leitstand (ein Prozess für alle Projekte) liest diese Liste.
register() {
  mkdir -p "$CONF" 2>/dev/null || return 0
  grep -qxF "$ROOT" "$CONF/projects.txt" 2>/dev/null || echo "$ROOT" >>"$CONF/projects.txt"
}
register

# ---- Rechner (hosts.conf: Zeilen NAME=wert, Werte mit Leerzeichen in Anführungszeichen) ----
LEADER="" HOSTS="" SELF="" BK_HOST_BASE=0
if [ -f "$CONF/hosts.conf" ]; then
  while IFS='=' read -r key val; do
    val=${val%\"} val=${val#\"}
    case $key in
      LEADER|HOSTS|SELF|BK_HOST_BASE) eval "$key=\$val" ;;
      HOST_[a-z]*_ROLES) case $key in *[!A-Za-z0-9_]*) ;; *) eval "$key=\$val" ;; esac ;;
    esac
  done <"$CONF/hosts.conf"
fi
case $BK_HOST_BASE in ''|*[!0-9]*) echo "BK_HOST_BASE in $CONF/hosts.conf ist keine Zahl" >&2; exit 1 ;; esac
for h in $HOSTS $SELF $LEADER; do
  case $h in *[!a-z0-9]*) echo "Rechnername nur a-z und 0-9: $h ($CONF/hosts.conf)" >&2; exit 1 ;; esac
done
MULTI=0
[ -z "$LEADER" ] || MULTI=1
[ -n "$SELF" ] || SELF=$(hostname -s 2>/dev/null | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9')

# Rollen, die `start` auf diesem Rechner ohne Angabe startet (leer = alle)
host_roles() { eval "printf '%s' \"\${HOST_$SELF""_ROLES-}\""; }

# ---- Markierungen: drain, drain-<rolle>, drain@<rechner>, autorestart ----
# Ein Rechner: Dateien im Git-Common-Dir, gemeinsam für alle Worktrees, nicht im Repo. Zwei
# Rechner: Schlüssel beadskit.<name> in `bd kv` der gemeinsamen Datenbank. Die Skills prüfen den
# Drain vor jedem Claim (drain-check); autorestart enthält die Schwelle in Tokens.
GIT_COMMON=$(git -C "$ROOT" rev-parse --path-format=absolute --git-common-dir)
DRAIN=$GIT_COMMON/$BK_SLUG-workers-drain
AUTO=$GIT_COMMON/$BK_SLUG-workers-autorestart

mark_file() {
  case $1 in
    autorestart) echo "$AUTO" ;;
    drain) echo "$DRAIN" ;;
    drain*) echo "$DRAIN${1#drain}" ;;
  esac
}

# Alle kv-Markierungen als "name=wert" je Zeile, einmal je Aufruf gelesen; Exit 1, wenn beads
# nicht antwortet
marks=""
marks_ok=""
marks_load() {
  [ -z "$marks_ok" ] || return "$marks_ok"
  if out=$(cd "$ROOT" && "$KIT/bdw" kv list --json 2>/dev/null) &&
    printf '%s' "$out" | jq -e 'type == "object"' >/dev/null 2>&1; then
    marks=$(printf '%s' "$out" | jq -r 'to_entries[] | select(.key | startswith("beadskit.")) | "\(.key | ltrimstr("beadskit."))=\(.value)"')
    marks_ok=0
  else
    marks="" marks_ok=1
  fi
  return "$marks_ok"
}

mark_has() {
  if [ "$MULTI" = 0 ]; then [ -e "$(mark_file "$1")" ]; return; fi
  marks_load || return 1
  printf '%s\n' "$marks" | grep -q "^$1="
}

mark_get() {
  if [ "$MULTI" = 0 ]; then cat "$(mark_file "$1")" 2>/dev/null; return 0; fi
  marks_load || return 0
  printf '%s\n' "$marks" | sed -n "s/^$1=//p" | head -n 1
}

mark_set() {
  if [ "$MULTI" = 0 ]; then printf '%s' "${2-}" >"$(mark_file "$1")"; return; fi
  marks_ok=""
  (cd "$ROOT" && BEADS_ACTOR=${BEADS_ACTOR:-user} "$KIT/bdw" kv set "beadskit.$1" "${2:-1}" >/dev/null 2>&1) ||
    { echo "beads antwortet nicht: Markierung $1 nicht gesetzt" >&2; exit 1; }
}

mark_rm() {
  if [ "$MULTI" = 0 ]; then rm -f "$(mark_file "$1")"; return; fi
  mark_has "$1" || return 0
  marks_ok=""
  (cd "$ROOT" && BEADS_ACTOR=${BEADS_ACTOR:-user} "$KIT/bdw" kv clear "beadskit.$1" >/dev/null 2>&1) ||
    { echo "beads antwortet nicht: Markierung $1 nicht entfernt" >&2; exit 1; }
}

# Globaler Drain oder Drain dieses Rechners
drain_all() { mark_has drain || { [ "$MULTI" = 1 ] && mark_has "drain@$SELF"; }; }

# ---- Terminal für Worker: iterm (macOS), tmux (Linux), bg (claude --bg) ----
TMUX_SESSION=bk-$BK_SLUG
# BK_UNAME nur für Tests
UNAME=${BK_UNAME:-$(uname)}
default_term() {
  if [ -n "${BK_TERM-}" ]; then echo "$BK_TERM"
  elif [ "$UNAME" = Darwin ]; then echo iterm
  elif command -v tmux >/dev/null 2>&1; then echo tmux
  else echo bg; fi
}

# Feld $2 (1 rolle, 2 workspace, 3 prompt, 4 farbe, 5 standard) der Rolle $1, leer wenn unbekannt
role_field() {
  printf '%s\n' "$ROLE_TABLE" | awk -F'|' -v r="$1" -v f="$2" '$1 == r { print $f; exit }'
}

# Rollen eines Workspaces (ohne Argument: alle), durch Leerzeichen getrennt, in Tabellenreihenfolge
roles_of() {
  printf '%s\n' "$ROLE_TABLE" | awk -F'|' -v w="${1-}" 'w == "" || $2 == w { printf "%s%s", sep, $1; sep = " " }'
}

ROLES=$(roles_of)

is_role() {
  case " $ROLES " in *" $1 "*) return 0 ;; esac
  return 1
}

is_ws() {
  case " $WORKSPACES " in *" $1 "*) return 0 ;; esac
  return 1
}

prompt_for() { role_field "$1" 3; }
# Terminalfarbe als "r g b"
color_for() { role_field "$1" 4; }

# Rollen mit Drain-Markierung ("alle" bei der globalen oder der dieses Rechners), leer ohne
# Drain; $1 = nur dieser Workspace
drained() {
  if drain_all; then echo alle; return; fi
  out=""
  for r in $(roles_of "${1-}"); do ! mark_has "drain-$r" || out="$out${out:+ }$r"; done
  [ -z "$out" ] || echo "$out"
}

# Name des n-ten Workers einer Rolle auf diesem Rechner
worker_name() { echo "$1-$((BK_HOST_BASE + $2))"; }

# Startbefehl im Terminal (Shell des Tabs bzw. tmux-Fensters)
term_cmd() { echo "cd '$ROOT' && claude -w $2 -n $2 '$(prompt_for "$1")'"; }

usage() {
  sed -n '7,20s/^# \{0,1\}//p' "$0" >&2
  exit 2
}

# Laufende Sessions dieses Repos als "<worktree> <kind> <status> <name> <pid> <ref>".
# <ref> ist die Session-ID für claude stop/attach/logs: Namen sind nicht eindeutig, weil
# `claude agents` gestoppte Sessions gleichen Namens weiter führt ("No job matching").
running() {
  claude agents --json 2>/dev/null | jq -r --arg wt "$WT_DIR/" '
    .[] | select(.cwd | startswith($wt))
    | "\(.cwd | ltrimstr($wt) | split("/")[0]) \(.kind) \(.status) \(.name) \(.pid) \(.id // .name)"' 2>/dev/null || true
}

# Session-ID eines laufenden Hintergrund-Workers (gesucht nach Worktree- oder
# Session-Name). Terminal-Worker (iTerm-Tab) erreichen attach/logs/stop nicht: Abbruch
# mit Hinweis statt der Meldung "No job matching" von claude.
session_of() {
  line=$(running | awk -v n="$1" '$1 == n || $4 == n { print; exit }')
  if [ -z "$line" ]; then
    echo "kein laufender Worker $1 (scripts/beadskit/workers ls)" >&2
    exit 1
  fi
  # shellcheck disable=SC2086 # Absicht: "<worktree> <kind> <status> <name> <pid> <ref>" zerlegen
  set -- $line
  if [ "$2" != background ]; then
    echo "$1 läuft in einem Terminal (iTerm-Tab bzw. tmux-Fenster $1), dort öffnen bzw. beenden" >&2
    exit 1
  fi
  echo "$6"
}

# Halter des Merge-Slots für ls; leer, wenn bd nicht antwortet
merge_slot() {
  (cd "$ROOT" && "$KIT/bdw" merge-slot check --json 2>/dev/null) |
    jq -r 'if .available then "frei" else "gehalten von \(.holder)" end' 2>/dev/null || true
}

# Namen der laufenden Worker (Worktrees), einmal je Aufruf gelesen
active=""
is_taken() {
  printf '%s\n' "$active" | grep -qx "$1"
}

# Zähler-Variable je Rolle (club-add → cnt_club_add); nur nach is_role aufrufen
cnt_var() { echo "cnt_$(echo "$1" | tr - _)"; }

# Setzt die Anzahl einer Rolle, bricht bei unbekannter Rolle oder Nicht-Zahl ab
set_count() {
  is_role "$1" || { echo "unbekannte Rolle: $1" >&2; usage; }
  case $2 in ''|*[!0-9]*) echo "$1=$2 ist keine Zahl" >&2; exit 2 ;; esac
  eval "$(cnt_var "$1")=\$2"
  case " $given " in *" $1 "*) ;; *) given="$given $1" ;; esac
}

count_of() {
  eval "echo \"\${$(cnt_var "$1"):-0}\""
}

# Alle Zähler auf 0 bzw. (mit $1 = default) auf den Standard der Tabelle
reset_counts() {
  for r in $ROLES; do
    n=0
    [ "${1-}" != default ] || n=$(role_field "$r" 5)
    eval "$(cnt_var "$r")=\$n"
  done
}

# Prüft das Terminal aus --term bzw. BK_TERM
check_term() {
  case $term in iterm|tmux|bg) ;; *) echo "unbekanntes Terminal: $term (iterm, tmux, bg)" >&2; exit 2 ;; esac
}

# Setzt Anzahlen ($given = genannte Rollen), ws, term und dry; mit bare=1 steht "fix" für fix=1.
# `npm run workers add fix --bg` (ohne --) gibt npm die Option nicht weiter, sondern setzt
# npm_config_bg=true; das zählt wie --bg, ebenso npm_config_dry_run. --iterm und --tmux sind
# Kurzformen von --term.
parse_args() {
  [ "${npm_config_bg-}" = true ] && term='bg'
  [ "${npm_config_dry_run-}" = true ] && dry=1
  given="" ws=""
  while [ $# -gt 0 ]; do
    case $1 in
      --iterm) term=iterm ;;
      --tmux) term=tmux ;;
      --bg) term='bg' ;;
      --term) [ $# -ge 2 ] || usage; term=$2; shift ;;
      --term=*) term=${1#*=} ;;
      --dry-run) dry=1 ;;
      --ws) [ $# -ge 2 ] || usage; ws=$2; shift ;;
      --ws=*) ws=${1#*=} ;;
      *=*) set_count "${1%%=*}" "${1#*=}" ;;
      *)
        [ "$bare" = 1 ] || { echo "unbekanntes Argument: $1" >&2; usage; }
        set_count "$1" 1
        ;;
    esac
    shift
  done
  check_term
  [ -z "$ws" ] || is_ws "$ws" || { echo "unbekannter Workspace: $ws ($WORKSPACES)" >&2; exit 2; }
}

# Warnt, wenn eine Rolle auf diesem Rechner laut hosts.conf nicht laufen soll (z. B. verify auf
# dem Mac: schläft er mit dem Merge-Slot, steht das Mergen still)
warn_host_role() {
  allowed=$(host_roles)
  [ -n "$allowed" ] || return 0
  case " $allowed " in *" $1 "*) return 0 ;; esac
  echo "Hinweis: $1 soll laut hosts.conf nicht auf $SELF laufen (HOST_${SELF}_ROLES=\"$allowed\")" >&2
}

# Workspace aus --ws oder den genannten Rollen; Rollen eines anderen Workspaces brechen ab.
# Ohne --ws und ohne Rollen: $1 (Standard code).
resolve_ws() {
  for r in $given; do
    rw=$(role_field "$r" 2)
    if [ -z "$ws" ]; then
      ws=$rw
    elif [ "$rw" != "$ws" ]; then
      echo "Rolle $r gehört zum Workspace $rw, nicht zu $ws (ein Workspace je Aufruf, --ws angeben)" >&2
      exit 2
    fi
  done
  [ -n "$ws" ] || ws=${1-code}
}

# Startet einen Worker im Hintergrund oder merkt ihn in $queued fürs Terminal vor
launch() {
  role=$1 name=$2
  prompt=$(prompt_for "$role")
  if [ "$term" != bg ]; then
    queued="$queued$role $name
"
    if [ "$dry" = 1 ]; then
      if [ "$term" = tmux ]; then echo "tmux-Fenster $name: claude -w $name -n $name '$prompt'"
      else echo "iTerm-Tab $name: claude -w $name -n $name '$prompt'"; fi
    fi
  elif [ "$dry" = 1 ]; then
    echo "(cd '$ROOT' && claude --bg -w $name -n $name '$prompt')"
  else
    echo "starte $name ($prompt)"
    bg_scope sh -c 'cd "$1" && shift && exec claude --bg "$@"' sh "$ROOT" -w "$name" -n "$name" "$prompt"
  fi
  return 0
}

# Führt einen Befehl, der dauerhafte Prozesse startet (tmux-Server, claude --bg), unter Linux
# in einem eigenen systemd-Scope aus: Startet ihn der Leitstand-Dienst, würde ein Neustart des
# Dienstes sonst alles in seiner cgroup beenden, auch die Worker.
bg_scope() {
  if [ "$UNAME" = Linux ] && command -v systemd-run >/dev/null 2>&1 &&
    systemd-run --user --scope --quiet true >/dev/null 2>&1; then
    systemd-run --user --scope --quiet --collect "$@"
  else
    "$@"
  fi
}

# Öffnet die vorgemerkten Worker als iTerm-Tabs; $1 = reuse: ins vorderste Fenster hängen
# (neues Fenster nur, wenn keins offen ist). Exit 1, wenn iTerm nicht steuerbar ist.
term_open_iterm() {
  list=$(mktemp)
  trap 'rm -f "$list"' EXIT
  printf '%s' "$queued" | while read -r role name; do
    [ -n "$name" ] || continue
    # shellcheck disable=SC2046 # Absicht: "r g b" in $1..$3 zerlegen
    set -- $(color_for "$role")
    # Tabfarbe per iTerm-Escape, dann claude im Repo-Wurzelordner
    echo "printf '\\033]6;1;bg;red;brightness;$1\\a\\033]6;1;bg;green;brightness;$2\\a\\033]6;1;bg;blue;brightness;$3\\a'; $(term_cmd "$role" "$name")"
  done >"$list"
  osascript - "$list" "$1" <<'APPLESCRIPT'
      on run argv
        set cmds to paragraphs of (read POSIX file (item 1 of argv) as «class utf8»)
        tell application "iTerm"
          activate
          if item 2 of argv is "reuse" and (count of windows) > 0 then
            set w to current window
            set first_tab to false
          else
            set w to (create window with default profile)
            set first_tab to true
          end if
          repeat with c in cmds
            if length of c > 0 then
              if first_tab then
                set first_tab to false
              else
                tell w to create tab with default profile
              end if
              tell current session of current tab of w to write text c
            end if
          end repeat
        end tell
      end run
APPLESCRIPT
}

# Öffnet die vorgemerkten Worker als Fenster der tmux-Session bk-<slug> (legt sie bei Bedarf an).
# Jedes Fenster behält seine Shell, wie ein iTerm-Tab. Exit 1 ohne tmux.
term_open_tmux() {
  command -v tmux >/dev/null 2>&1 || return 1
  if ! tmux has-session -t "=$TMUX_SESSION" 2>/dev/null; then
    bg_scope tmux new-session -d -s "$TMUX_SESSION" -n shell -c "$ROOT" || return 1
  fi
  printf '%s' "$queued" | while read -r role name; do
    [ -n "$name" ] || continue
    pane=$(tmux new-window -d -P -F '#{pane_id}' -t "=$TMUX_SESSION:" -n "$name" -c "$ROOT") || exit 1
    # shellcheck disable=SC2046 # Absicht: "r g b" in $1..$3 zerlegen
    set -- $(color_for "$role")
    tmux set-option -w -t "$pane" window-status-style "bg=$(printf '#%02x%02x%02x' "$1" "$2" "$3")" 2>/dev/null || true
    tmux send-keys -t "$pane" -l -- "$(term_cmd "$role" "$name")" && tmux send-keys -t "$pane" Enter || exit 1
  done
}

# Öffnet die vorgemerkten Terminal-Worker bzw. gibt den Hinweis für Hintergrund-Worker aus.
# $1 = reuse: iTerm-Tabs ins vorderste Fenster hängen
finish() {
  if [ "$term" != bg ] && [ -n "$queued" ] && [ "$dry" = 0 ]; then
    if [ "$term" = tmux ]; then what=tmux-Fenster; else what=iTerm-Tab; fi
    if ! "term_open_$term" "${1-new}"; then
      # z. B. Leitstand ohne Automation-Freigabe für iTerm: lieber im Hintergrund als gar nicht
      echo "$what nicht steuerbar, starte im Hintergrund" >&2
      term='bg'
      printf '%s' "$queued" | while read -r role name; do
        [ -n "$name" ] && launch "$role" "$name"
      done
    else
      printf '%s' "$queued" | while read -r _ name; do [ -n "$name" ] && echo "starte $name ($what)"; done
      [ "$term" != tmux ] || echo "öffnen: tmux attach -t $TMUX_SESSION (bzw. scripts/beadskit/workers attach <name>)"
    fi
  fi
  if [ "$term" = bg ] && [ "$dry" = 0 ]; then
    echo "Übersicht: scripts/beadskit/workers ls · öffnen: scripts/beadskit/workers attach <name>"
  fi
}

cmd_start() {
  term=$(default_term) dry=0 bare=0
  reset_counts default
  parse_args "$@"
  resolve_ws code

  # Ohne Angabe nur die Rollen, die laut hosts.conf auf diesem Rechner laufen sollen
  allowed=$(host_roles)
  if [ -n "$allowed" ]; then
    for r in $(roles_of "$ws"); do
      case " $given " in *" $r "*) continue ;; esac
      case " $allowed " in *" $r "*) ;; *) eval "$(cnt_var "$r")=0" ;; esac
    done
  fi
  for r in $given; do [ "$(count_of "$r")" = 0 ] || warn_host_role "$r"; done

  # Drain nur für diesen Workspace aufheben; ein globaler Drain bleibt für die übrigen Workspaces
  # als Rollenmarkierung bestehen, damit deren Worker weiter auslaufen. Den Drain dieses Rechners
  # hebt start ganz auf.
  d=$(drained "$ws")
  if [ -n "$d" ]; then
    others=""
    if mark_has drain; then
      for r in $ROLES; do
        [ "$(role_field "$r" 2)" = "$ws" ] || others="$others $r"
      done
    fi
    if [ "$dry" = 1 ]; then
      echo "(Drain-Markierung würde für Workspace $ws entfernt: $d)"
      [ -z "$others" ] || echo "(globaler Drain bliebe für:$others)"
    else
      for r in $others; do mark_set "drain-$r"; done
      mark_rm drain
      [ "$MULTI" = 0 ] || mark_rm "drain@$SELF"
      for r in $(roles_of "$ws"); do mark_rm "drain-$r"; done
      echo "Drain-Markierung für Workspace $ws entfernt: $d"
      [ -z "$others" ] || echo "globaler Drain bleibt für:$others"
    fi
  fi

  active=$(running | awk '{ print $1 }')
  queued=""
  for role in $(roles_of "$ws"); do
    count=$(count_of "$role")
    n=1
    while [ "$n" -le "$count" ]; do
      name=$(worker_name "$role" "$n")
      n=$((n + 1))
      if is_taken "$name"; then
        echo "$name läuft schon, übersprungen"
        continue
      fi
      launch "$role" "$name"
    done
  done
  finish
}

# Startet N weitere Worker je Rolle mit der jeweils niedrigsten freien Nummer.
# Bei aktivem Drain nicht: neue Worker würden sofort aufhören, und die Markierung zu
# entfernen würde auch die auslaufenden Worker wieder claimen lassen.
cmd_add() {
  term=$(default_term) dry=0 bare=1
  reset_counts
  parse_args "$@"
  [ -n "$given" ] || usage
  # nur zur Prüfung: mit --ws müssen alle Rollen dazu gehören
  [ -z "$ws" ] || resolve_ws
  for role in $given; do
    if drain_all || mark_has "drain-$role"; then
      echo "Drain aktiv für $role: neue Worker würden sofort wieder aufhören." >&2
      echo "Erst scripts/beadskit/workers drain $role --off (bzw. drain --off), dann add." >&2
      exit 1
    fi
    warn_host_role "$role"
  done

  active=$(running | awk '{ print $1 }')
  queued=""
  for role in $ROLES; do
    count=$(count_of "$role")
    n=1
    while [ "$count" -gt 0 ]; do
      name=$(worker_name "$role" "$n")
      n=$((n + 1))
      is_taken "$name" && continue
      active="$active
$name"
      launch "$role" "$name"
      count=$((count - 1))
    done
  done
  finish reuse
}

cmd_ls() {
  ws=""
  while [ $# -gt 0 ]; do
    case $1 in
      --ws) [ $# -ge 2 ] || usage; ws=$2; shift ;;
      --ws=*) ws=${1#*=} ;;
      *) usage ;;
    esac
    shift
  done
  [ -z "$ws" ] || is_ws "$ws" || { echo "unbekannter Workspace: $ws ($WORKSPACES)" >&2; exit 2; }
  if [ "$MULTI" = 1 ]; then
    echo "Rechner: $SELF (Leitrechner $LEADER, Worker ab $(worker_name "<rolle>" 1))"
    marks_load || echo "beads auf $LEADER antwortet nicht: Markierungen und Merge-Slot unbekannt"
    for h in $HOSTS; do
      [ "$h" = "$SELF" ] || ! mark_has "drain@$h" || echo "Drain aktiv für Rechner $h"
    done
  fi
  d=$(drained "$ws")
  [ -z "$d" ] || echo "Drain aktiv ($d): diese Worker hören nach dem aktuellen Schritt auf"
  slot=$(merge_slot)
  [ -z "$slot" ] || echo "Merge-Slot: $slot"
  if mark_has autorestart; then
    t=$(mark_get autorestart)
    case $t in ''|*[!0-9]*) echo "Auto-Neustart: Schwelle unlesbar ($t)" ;;
      *) echo "Auto-Neustart ab $((t / 1000))k Tokens (durch den Leitstand)" ;; esac
  fi
  out=$(running)
  if [ -n "$ws" ]; then
    out=$(printf '%s\n' "$out" | while read -r wt rest; do
      [ -n "$wt" ] && [ "$(role_field "${wt%-*}" 2)" = "$ws" ] && echo "$wt $rest"
    done || true)
  fi
  if [ -z "$out" ]; then
    echo "keine Worker aktiv${ws:+ im Workspace $ws}"
    return
  fi
  printf '%-18s %-6s %-12s %-6s %s\n' WORKER WS ART STATUS SESSION
  echo "$out" | sort | while read -r wt kind status name _; do
    [ "$kind" = background ] || kind="terminal"
    w=$(role_field "${wt%-*}" 2)
    printf '%-18s %-6s %-12s %-6s %s\n' "$wt" "${w:--}" "$kind" "$status" "$name"
  done
}

cmd_drain() {
  off=0 roles="" host=""
  while [ $# -gt 0 ]; do
    case $1 in
      --off) off=1 ;;
      --host|--host=*)
        if [ "$1" = --host ]; then [ $# -ge 2 ] || usage; host=$2; shift; else host=${1#*=}; fi
        [ "$MULTI" = 1 ] || { echo "--host nur mit zwei Rechnern ($CONF/hosts.conf)" >&2; exit 2; }
        case " $HOSTS " in *" $host "*) ;; *) echo "unbekannter Rechner: $host ($HOSTS)" >&2; exit 2 ;; esac ;;
      --ws|--ws=*)
        if [ "$1" = --ws ]; then [ $# -ge 2 ] || usage; w=$2; shift; else w=${1#*=}; fi
        is_ws "$w" || { echo "unbekannter Workspace: $w ($WORKSPACES)" >&2; exit 2; }
        roles="$roles $(roles_of "$w")" ;;
      *)
        is_role "$1" || { echo "unbekannte Rolle: $1" >&2; usage; }
        roles="$roles $1" ;;
    esac
    shift
  done
  if [ -n "$host" ]; then
    [ -z "$roles" ] || { echo "--host gilt für alle Rollen eines Rechners, ohne Rollen und --ws" >&2; exit 2; }
    if [ "$off" = 1 ]; then
      mark_rm "drain@$host"
      echo "Drain für Rechner $host aufgehoben"
    else
      mark_set "drain@$host"
      echo "Drain aktiv für Rechner $host: dessen Worker machen ihren laufenden Schritt fertig,"
      echo "claimen nichts Neues und hören auf; die übrigen Rechner arbeiten weiter."
    fi
    return
  fi
  if [ "$off" = 1 ]; then
    if [ -z "$roles" ]; then
      mark_rm drain
      for r in $ROLES; do mark_rm "drain-$r"; done
      for h in $HOSTS; do mark_rm "drain@$h"; done
      echo "Drain aufgehoben, alle Worker claimen wieder"
    else
      for r in $roles; do mark_rm "drain-$r"; done
      echo "Drain aufgehoben für:$roles"
      ! drain_all || echo "Achtung: globaler Drain bleibt aktiv (drain --off hebt ihn auf)"
    fi
    return
  fi
  if [ -z "$roles" ]; then
    mark_set drain
    echo "Drain aktiv: Worker machen ihren laufenden Schritt fertig, claimen nichts Neues"
    echo "und hören auf. Fortschritt: scripts/beadskit/workers ls, danach stop --all."
  else
    for r in $roles; do mark_set "drain-$r"; done
    echo "Drain aktiv für:$roles. Diese Worker machen ihren laufenden Schritt fertig und"
    echo "hören auf, die übrigen arbeiten weiter. Fortschritt: scripts/beadskit/workers ls."
  fi
}

# Drain-Check der Skills vor jedem Claim (worker-regeln.md „Auslaufen“). Ein einfacher Aufruf,
# weil die Worktree-Sandbox zusammengesetzte Befehle mit git ablehnt. Rolle aus dem Namen des
# aufrufenden Worktrees (fix-2 → fix, club-add-1 → club-add). Immer Exit 0; die Ausgabe beginnt mit DRAIN oder lautet
# "kein Drain".
cmd_drain_check() {
  [ $# -le 1 ] || usage
  role=${1:-}
  if [ -z "$role" ]; then
    top=$(git rev-parse --show-toplevel 2>/dev/null) || top=""
    role=$(basename "$top" | sed 's/-[0-9]*$//')
  fi
  # Zwei Rechner: antwortet beads nicht, gilt kein Drain (der Claim scheitert dann ohnehin, und
  # ein kurzer Netzaussetzer soll den /loop nicht beenden)
  if mark_has drain; then
    echo "DRAIN (alle Worker)"
  elif [ "$MULTI" = 1 ] && mark_has "drain@$SELF"; then
    echo "DRAIN (Rechner $SELF)"
  elif [ -n "$role" ] && mark_has "drain-$role"; then
    echo "DRAIN (Rolle $role)"
  else
    echo "kein Drain"
  fi
}

# Bricht ab, solange ein Worker nicht idle ist, mit Hinweis auf drain. --force übergeht die Prüfung.
guard_busy() {
  busy=$(running | awk ${1:+-v only="$1"} '(only == "" || $1 == only) && $3 != "idle" { print $1 }')
  [ -z "$busy" ] && return 0
  echo "noch aktiv: $(echo "$busy" | tr '\n' ' ')" >&2
  if [ -n "$(drained)" ]; then
    echo "Drain läuft, warten bis idle (scripts/beadskit/workers ls) oder --force" >&2
  else
    echo "Stopp jetzt bricht mitten in der Arbeit ab (Claim, Branch, Merge-Slot)." >&2
    echo "Besser: scripts/beadskit/workers drain, dann warten; sonst --force" >&2
  fi
  exit 1
}

# Beendet einen Terminal-Worker: SIGTERM an die Session (wie restart; ein getipptes /exit wird nicht
# zuverlässig abgeschickt), unter tmux danach sein Fenster. Ein iTerm-Tab bleibt mit seiner Shell offen.
stop_terminal() {
  case $2 in ''|*[!0-9]*) echo "$1: keine PID" >&2; return 1 ;; esac
  kill -TERM "$2" 2>/dev/null || true
  n=0
  while kill -0 "$2" 2>/dev/null && [ "$n" -lt 20 ]; do sleep 1; n=$((n + 1)); done
  if kill -0 "$2" 2>/dev/null; then
    echo "$1: Session beendet sich nicht (PID $2)" >&2
    return 1
  fi
  if command -v tmux >/dev/null 2>&1 &&
    tmux list-windows -t "=$TMUX_SESSION" -F '#{window_name}' 2>/dev/null | grep -qxF "$1"; then
    tmux kill-window -t "=$TMUX_SESSION:=$1" 2>/dev/null || true
  fi
}

cmd_stop() {
  force=0 target=""
  for arg in "$@"; do
    case $arg in
      --force) force=1 ;;
      *) [ -z "$target" ] || usage; target=$arg ;;
    esac
  done
  [ -n "$target" ] || usage
  if [ "$force" = 0 ]; then
    if [ "$target" = --all ]; then guard_busy; else guard_busy "$target"; fi
  fi
  if [ "$target" = --all ]; then
    # Ohne Pipe, damit $failed die Schleife überlebt; ein Fehler stoppt die übrigen nicht
    list=$(running) failed=""
    while read -r wt kind _ _ pid ref; do
      [ -n "$wt" ] || continue
      echo "stoppe $wt"
      if [ "$kind" = background ]; then
        claude stop "$ref" || failed="$failed $wt"
      else
        stop_terminal "$wt" "$pid" || failed="$failed $wt"
      fi
    done <<EOF
$list
EOF
    [ -z "$failed" ] || { echo "nicht gestoppt:$failed" >&2; exit 1; }
  else
    line=$(running | awk -v n="$target" '$1 == n || $4 == n { print; exit }')
    [ -n "$line" ] || { echo "kein laufender Worker $target (scripts/beadskit/workers ls)" >&2; exit 1; }
    # shellcheck disable=SC2086 # Absicht: "<worktree> <kind> <status> <name> <pid> <ref>" zerlegen
    set -- $line
    if [ "$2" = background ]; then claude stop "$6"; else stop_terminal "$1" "$5"; fi
  fi
}

# TTY eines Prozesses als /dev/…; leer ohne Terminal (BSD-ps zeigt dann ??, procps ?)
tty_of() {
  t=$(ps -o tty= -p "$1" 2>/dev/null | tr -d ' ') || t=""
  case $t in ''|'?'|'??') ;; /dev/*) echo "$t" ;; *) echo "/dev/$t" ;; esac
}

# Schreibt Text (mit Enter) in das Terminal mit diesem TTY: ein tmux-Pane oder eine
# iTerm-Session. Ohne Text nur Prüfung, ob es das gibt. Exit 1 ohne passendes Terminal.
term_write() {
  if command -v tmux >/dev/null 2>&1; then
    pane=$(tmux list-panes -a -F '#{pane_tty} #{pane_id}' 2>/dev/null | awk -v t="$1" '$1 == t { print $2; exit }')
    if [ -n "$pane" ]; then
      [ -z "${2-}" ] || { tmux send-keys -t "$pane" -l -- "$2" && tmux send-keys -t "$pane" Enter; }
      return
    fi
  fi
  [ "$UNAME" = Darwin ] || return 1
  osascript - "$1" "${2-}" >/dev/null <<'APPLESCRIPT'
    on run argv
      tell application "iTerm"
        repeat with w in windows
          repeat with t in tabs of w
            repeat with s in sessions of t
              if tty of s is (item 1 of argv) then
                if (item 2 of argv) is not "" then tell s to write text (item 2 of argv)
                return
              end if
            end repeat
          end repeat
        end repeat
      end tell
      error "kein iTerm-Tab mit " & (item 1 of argv) number 1
    end run
APPLESCRIPT
}

# Startet einen Worker mit frischem Kontext neu. Ohne --force nur zwischen zwei Runden: idle,
# kein Issue in Arbeit, Merge-Slot nicht bei ihm. Bei Drain nie (er hört ohnehin auf).
cmd_restart() {
  force=0 dry=0 term=$(default_term) target=""
  while [ $# -gt 0 ]; do
    case $1 in
      --force) force=1 ;;
      --dry-run) dry=1 ;;
      --bg) term='bg' ;;
      --iterm) term=iterm ;;
      --tmux) term=tmux ;;
      --term) [ $# -ge 2 ] || usage; term=$2; shift ;;
      --term=*) term=${1#*=} ;;
      -*) usage ;;
      *) [ -z "$target" ] || usage; target=$1 ;;
    esac
    shift
  done
  check_term
  role=${target%-*}
  is_role "$role" || role=""
  case ${target##*-} in ''|*[!0-9]*) role="" ;; esac
  [ -n "$role" ] || { echo "unbekannter Worker: $target" >&2; exit 2; }

  line=$(running | awk -v n="$target" '$1 == n { print; exit }')
  if [ -z "$line" ]; then
    echo "kein laufender Worker $target (scripts/beadskit/workers ls)" >&2
    exit 1
  fi
  # shellcheck disable=SC2086 # Absicht: "<worktree> <kind> <status> <name> <pid> <ref>" zerlegen
  set -- $line
  kind=$2 status=$3 session=$6 pid=$5
  if drain_all || mark_has "drain-$role"; then
    echo "Drain aktiv für $role: $target hört ohnehin auf, kein Neustart" >&2
    exit 1
  fi

  if [ "$force" = 0 ]; then
    [ "$status" = idle ] || { echo "$target ist $status, nicht idle: Neustart erst zwischen zwei Runden" >&2; exit 1; }
    # Exit-Status von bdw selbst prüfen: jq endet auf leerer Eingabe mit 0, das hieße "keine Claims"
    list=$(cd "$ROOT" && "$KIT/bdw" list --status in_progress --json 2>/dev/null) && [ -n "$list" ] &&
      claims=$(printf '%s' "$list" | jq -er --arg n "$target" '[.[] | select(.assignee == $n) | .id] | join(" ")' 2>/dev/null) ||
      { echo "beads antwortet nicht, Claims von $target unbekannt: kein Neustart" >&2; exit 1; }
    [ -z "$claims" ] || { echo "$target hat noch $claims in Arbeit: kein Neustart" >&2; exit 1; }
    slot=$(cd "$ROOT" && "$KIT/bdw" merge-slot check --json 2>/dev/null) && [ -n "$slot" ] &&
      holder=$(printf '%s' "$slot" | jq -er '.holder // ""' 2>/dev/null) ||
      { echo "Merge-Slot unbekannt: kein Neustart" >&2; exit 1; }
    [ "$holder" != "$target" ] || { echo "$target hält den Merge-Slot: kein Neustart" >&2; exit 1; }
  fi

  if [ "$kind" = background ]; then
    if [ "$dry" = 1 ]; then
      echo "claude stop $session"
    else
      echo "stoppe $target"
      claude stop "$session"
    fi
    queued=""
    launch "$role" "$target"
    finish reuse
    return
  fi

  # Terminal (iTerm-Tab, tmux-Fenster): Session per SIGTERM beenden (in die Claude-Oberfläche
  # getipptes /exit wird nicht zuverlässig abgeschickt), dann den Startbefehl in die Shell mit
  # demselben TTY tippen
  tty=$(tty_of "$pid")
  [ -n "$tty" ] || { echo "$target: kein Terminal zur PID $pid gefunden" >&2; exit 1; }
  cmd=$(term_cmd "$role" "$target")
  if [ "$dry" = 1 ]; then
    echo "kill -TERM $pid, dann im Terminal $tty: $cmd"
    return
  fi
  # erst das Terminal prüfen, damit nichts beendet wird, das sich nicht neu starten lässt
  term_write "$tty" || { echo "$target: kein Terminal mit $tty (iTerm-Tab, tmux-Fenster)" >&2; exit 1; }
  kill -TERM "$pid"
  n=0
  while kill -0 "$pid" 2>/dev/null && [ "$n" -lt 30 ]; do sleep 1; n=$((n + 1)); done
  if kill -0 "$pid" 2>/dev/null; then
    echo "$target: Session beendet sich nicht (PID $pid), Terminal $tty prüfen" >&2
    exit 1
  fi
  term_write "$tty" "$cmd"
  echo "$target im Terminal $tty neu gestartet"
}

# Tippt eine Zeile (Nachricht oder /befehl) ins Terminal eines Workers (iTerm-Tab, tmux-Fenster); Claude reiht
# sie ein, wenn der Worker gerade arbeitet. Hintergrund-Worker erreicht nur `attach`.
cmd_send() {
  [ $# -ge 1 ] || usage
  target=$1
  shift
  [ "${1-}" != -- ] || shift
  text=$*
  [ -n "$text" ] || { echo "kein Text" >&2; exit 2; }
  case $text in *"
"*) echo "nur eine Zeile (Enter schickt ab)" >&2; exit 2 ;; esac
  line=$(running | awk -v n="$target" '$1 == n { print; exit }')
  [ -n "$line" ] || { echo "kein laufender Worker $target (scripts/beadskit/workers ls)" >&2; exit 1; }
  # shellcheck disable=SC2086 # Absicht: "<worktree> <kind> <status> <name> <pid> <ref>" zerlegen
  set -- $line
  if [ "$2" = background ]; then
    echo "$target läuft im Hintergrund: Nachrichten nur über scripts/beadskit/workers attach $target" >&2
    exit 1
  fi
  tty=$(tty_of "$5")
  [ -n "$tty" ] || { echo "$target: kein Terminal zur PID $5 gefunden" >&2; exit 1; }
  term_write "$tty" "$text" || { echo "$target: kein Terminal mit $tty (iTerm-Tab, tmux-Fenster)" >&2; exit 1; }
  echo "an $target gesendet"
}

# Schaltet den Auto-Neustart des Leitstands an (Schwelle 50k–900k Tokens) oder aus
cmd_autorestart() {
  over=200k
  while [ $# -gt 0 ]; do
    case $1 in
      --off) mark_rm autorestart; echo "Auto-Neustart aus"; return ;;
      --over) [ $# -ge 2 ] || usage; over=$2; shift ;;
      --over=*) over=${1#*=} ;;
      *) usage ;;
    esac
    shift
  done
  case $over in
    *k) tokens=${over%k} ;;
    *) tokens=$over ;;
  esac
  case $tokens in ''|*[!0-9]*) echo "Schwelle $over ist keine Zahl (z. B. 200k)" >&2; exit 2 ;; esac
  case $over in *k) tokens=$((tokens * 1000)) ;; esac
  if [ "$tokens" -lt 50000 ] || [ "$tokens" -gt 900000 ]; then
    echo "Schwelle 50k–900k Tokens" >&2
    exit 2
  fi
  mark_set autorestart "$tokens"
  echo "Auto-Neustart ab $((tokens / 1000))k Tokens: der Leitstand startet idle Worker ohne Claim"
  echo "neu, solange er läuft (scripts/beadskit/leitstand/inbox.mjs)."
}

# Repos des Projekts als "<schlüssel> <absoluter pfad>" je Zeile, das eigene zuerst (Schlüssel ".")
repos() {
  echo ". $ROOT"
  for kv in $BK_REPOS; do
    key=${kv%%:*} path=${kv#*:}
    [ "$key" != . ] || continue
    case $path in /*) ;; *) path=$ROOT/$path ;; esac
    path=$(cd "$path" 2>/dev/null && pwd -P) || { echo "Repo $key fehlt: ${kv#*:} (BK_REPOS)" >&2; continue; }
    echo "$key $path"
  done
}

# Repo eines Issues: Label modul:<schlüssel> eines Eintrags in BK_REPOS, sonst dieses Repo
cmd_repo_for() {
  labels=$(cd "$ROOT" && "$KIT/bdw" show "$1" --json 2>/dev/null |
    jq -r '(if type == "array" then .[0] else . end) | .labels // [] | .[]' 2>/dev/null) ||
    { echo "Issue $1 nicht gefunden" >&2; exit 1; }
  out=$ROOT list=$(repos)
  while read -r key path; do
    [ "$key" != . ] || continue
    if printf '%s\n' "$labels" | grep -qxF "modul:$key"; then out=$path; break; fi
  done <<EOF
$list
EOF
  echo "$out"
}

# Was der Leitstand über das Projekt wissen muss
cmd_config() {
  # eigene CI-Runner: ein Workflow wählt runs-on self-hosted (scripts/beadskit/ci/runner-server)
  runners=false
  ! grep -qs 'self-hosted' "$ROOT"/.github/workflows/*.y*ml || runners=true
  {
    printf '%s\n' "$ROLE_TABLE" | while IFS='|' read -r r w p c d; do
      jq -nc --arg r "$r" --arg w "$w" --arg p "$p" --arg c "$c" --arg d "$d" \
        '{kind: "role", role: $r, ws: $w, prompt: $p, color: ($c | split(" ") | map(tonumber)), start: ($d | tonumber)}'
    done
    for w in $WORKSPACES; do
      if [ "$w" = code ]; then name=Code phases=$BK_PHASES; else name=$(ws_var "$w" NAME) phases=$(ws_var "$w" PHASES); fi
      jq -nc --arg w "$w" --arg n "${name:-$w}" --arg ph "$phases" '{kind: "ws", ws: $w, name: $n, phases: $ph}'
    done
    repos | while read -r key path; do
      jq -nc --arg k "$key" --arg p "$path" '{kind: "repo", key: $k, path: $p}'
    done
  } | jq -s --arg root "$ROOT" --arg name "$BK_NAME" --arg slug "$BK_SLUG" --arg base "$BK_BASE" \
      --arg modules "$BK_MODULES" --arg drain "$DRAIN" --arg auto "$AUTO" --argjson runners "$runners" \
      --arg host "$SELF" --arg leader "$LEADER" --arg hosts "$HOSTS" --argjson hostBase "$BK_HOST_BASE" \
      --arg markers "$([ "$MULTI" = 1 ] && echo kv || echo file)" --arg term "$(default_term)" --arg tmux "$TMUX_SESSION" '
    def words: split(" ") | map(select(length > 0));
    # "place:Anlegen settings" → [{key: "place", title: "Anlegen"}, {key: "settings", title: null}]
    def phases: words | map(split(":") | {key: .[0], title: (.[1:] | join(":") | if . == "" then null else . end)});
    (map(select(.kind == "role"))) as $roles
    | { root: $root, name: $name, slug: $slug, base: $base,
        roles: [$roles[].role], modules: ($modules | words), drain: $drain, autorestart: $auto,
        start: ($roles | map({key: .role, value: .start}) | from_entries),
        prompts: ($roles | map({key: .role, value: .prompt}) | from_entries),
        colors: ($roles | map({key: .role, value: .color}) | from_entries),
        workspaces: [map(select(.kind == "ws"))[] | .ws as $w
          | {key: $w, name, phases: (.phases | phases), roles: [$roles[] | select(.ws == $w) | .role]}],
        repos: [map(select(.kind == "repo"))[] | {key, path}], runners: $runners,
        host: $host, leader: (if $leader == "" then null else $leader end), hosts: ($hosts | words),
        hostBase: $hostBase, markers: $markers, term: $term, tmuxSession: $tmux }'
}

# Öffnet einen Worker: tmux-Fenster (wechselt in der laufenden tmux-Sitzung dorthin) oder
# Hintergrund-Session
cmd_attach() {
  if command -v tmux >/dev/null 2>&1 &&
    tmux list-windows -t "=$TMUX_SESSION" -F '#{window_name}' 2>/dev/null | grep -qxF "$1"; then
    if [ -n "${TMUX-}" ]; then exec tmux switch-client -t "=$TMUX_SESSION:=$1"; fi
    tmux select-window -t "=$TMUX_SESSION:=$1"
    exec tmux attach-session -t "=$TMUX_SESSION"
  fi
  session=$(session_of "$1")
  exec claude attach "$session"
}

[ $# -ge 1 ] || usage
sub=$1
shift
case $sub in
  start) cmd_start "$@" ;;
  add) cmd_add "$@" ;;
  ls) cmd_ls "$@" ;;
  attach) [ $# = 1 ] || usage; cmd_attach "$1" ;;
  logs) [ $# = 1 ] || usage; session=$(session_of "$1"); exec claude logs "$session" ;;
  drain) cmd_drain "$@" ;;
  drain-check) cmd_drain_check "$@" ;;
  stop) cmd_stop "$@" ;;
  restart) cmd_restart "$@" ;;
  autorestart) cmd_autorestart "$@" ;;
  send) cmd_send "$@" ;;
  repo-for) [ $# = 1 ] || usage; cmd_repo_for "$1" ;;
  config) cmd_config ;;
  top) exec node "$KIT/leitstand/top.mjs" "$@" ;;
  *) usage ;;
esac
