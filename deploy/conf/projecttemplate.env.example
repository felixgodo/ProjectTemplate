# Vorlage für /etc/projecttemplate/projecttemplate.env – setup.sh füllt Port und Datenbank selbst (chmod 600!)

APP_BASE_URL=https://example.org

# Port des Backends auf 127.0.0.1 (setup.sh wählt ab 8100 den nächsten freien)
SERVER_PORT=8100

# Speicher der JVM – nur setzen, wenn der Standard aus projecttemplate.service nicht reicht
#JAVA_OPTS=-Xmx512m

# Datenbank (setup.sh legt sie an und trägt das Passwort ein)
DB_URL=jdbc:mariadb://localhost:3306/projecttemplate?allowPublicKeyRetrieval=true
DB_USER=projecttemplate
DB_PASSWORD=CHANGE_ME
